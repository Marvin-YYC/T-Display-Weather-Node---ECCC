  uint16_t alertColorFor(const String &title) {
  String t = title;
  t.toLowerCase();
if (t.indexOf("red") >= 0) return TFT_RED;
  if (t.indexOf("orange") >= 0) return TFT_ORANGE;
  if (t.indexOf("yellow") >= 0) return TFT_YELLOW;
  if (t.indexOf("special") >= 0) return TFT_GREENYELLOW;

  return TFT_LIGHTGREY; /// TFT_DARKGREY
}

// ===== XML Helpers =====
String extractXmlValue(const String &xml, const String &tag) {
  String open  = "<" + tag;
  int idx = xml.indexOf(open);
  if (idx == -1) return "";
  idx = xml.indexOf(">", idx);
  if (idx == -1) return "";
  idx++;
  int end = xml.indexOf("</" + tag + ">", idx);
  if (end == -1) return "";
  return xml.substring(idx, end);
}

String extractLabeledValue(const String &src, const String &label) {
  int start = src.indexOf(label);
  if (start == -1) return "";
  start += label.length();
  int end = src.indexOf('\n', start);
  if (end == -1) end = src.length();
  String val = src.substring(start, end);
  val.trim();
  return val;
}
