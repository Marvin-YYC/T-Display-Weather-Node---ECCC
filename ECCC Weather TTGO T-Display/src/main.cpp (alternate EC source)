// ===== Fetch and Parse Weather =====
void fetchWeather() {
  HTTPClient http;
  http.begin(WEATHER_RSS_URL);

  int code = http.GET();
  Serial.printf("Weather RSS HTTP code: %d\n", code);

  if (code == 200) {
    String xml = http.getString();
    fetchForecast24h(xml);


    // Find correct <entry> with current conditions
    int pos = 0;
    while (true) {
      int start = xml.indexOf("<entry>", pos);
      if (start == -1) break;
      int end   = xml.indexOf("</entry>", start);
      if (end == -1) break;

      String entry = xml.substring(start, end);

      // Category for current conditions
      String entryTitle = extractXmlValue(entry, "title");

        // Select the "Current Conditions" entry
        if (!entryTitle.startsWith("Current Conditions")) {
          pos = end + 8;
          continue;
        }
      // Extract updated timestamp
      ccUpdated = extractXmlValue(entry, "updated");
      // Extract summary CDATA
      String summary = extractXmlValue(entry, "summary");
      
      summary.replace("<![CDATA[", "");
      summary.replace("]]>", "");
      summary.replace("<br/>", "\n");
      summary.replace("<br />", "\n");
      summary.replace("<b>", "");
      summary.replace("</b>", "");
      summary.replace("&deg;C", ""); // add C 
      summary.trim();

      // Parse labeled values
      ccObservedAt = formatObservedTime(
                 extractLabeledValue(summary, "Observed at:")
               );

      //ccObservedAt  = extractLabeledValue(summary, "Observed at:");
      ccCondition   = extractLabeledValue(summary, "Condition:");
      ccTemperature = extractLabeledValue(summary, "Temperature:");
      ccPressure    = extractLabeledValue(summary, "Pressure / Tendency:");
      ccVisibility  = extractLabeledValue(summary, "Visibility:");
      ccHumidity    = extractLabeledValue(summary, "Humidity:");
      ccDewpoint    = extractLabeledValue(summary, "Dewpoint:");
      ccWindChill   = extractLabeledValue(summary, "Wind Chill:");
      ccWind        = extractLabeledValue(summary, "Wind:");
      ccGust        = extractLabeledValue(summary, "Gust:");
      ccAQHI        = extractLabeledValue(summary, "Air Quality Health Index:");

      break;
    }

    Serial.println("Parsed Weather:");
    Serial.println(ccObservedAt);
    Serial.println(ccCondition);
    Serial.println(ccTemperature);

  }

  http.end();
}
void fetchForecast24h(const String &xml) {

  fc6hrTitle = "";
  fc6hrSummary = "";
  fc12hrTitle = "";
  fc12hrSummary = "";

  int pos = 0;
  int found = 0;

  while (true) {
    int start = xml.indexOf("<entry>", pos);
    if (start == -1) break;

    int end = xml.indexOf("</entry>", start);
    if (end == -1) break;

    String entry = xml.substring(start, end);
    pos = end + 8;

    // Only forecast entries
    if (entry.indexOf("Weather Forecasts") == -1) continue;

    String title   = extractXmlValue(entry, "title");
    String summary = extractXmlValue(entry, "summary");

    // Clean HTML / CDATA
    summary.replace("<![CDATA[", "");
    summary.replace("]]>", "");
    summary.replace("<br/>", "\n");
    summary.replace("<br />", "\n");
    summary.replace("<b>", "");
    summary.replace("</b>", "");
    summary.trim();

    if (found == 0) {
      fc6hrTitle = title;
      fc6hrSummary = summary;
    } else if (found == 1) {
      fc12hrTitle = title;
      fc12hrSummary = summary;
      break;  // we only need 24h
    }

    found++;
  }
}

// ===== Fetch and Parse Alerts =====
void fetchAlerts() {
  HTTPClient http;
  http.begin(ALERTS_RSS_URL);
  int code = http.GET();
  Serial.printf("Alerts RSS HTTP code: %d\n", code);

  if (code == 200) {
    String xml = http.getString();
    // Parse first alert entry
    int pos = 0;
    alertTitle = "";
    alertSummary = "";

    while (true) {
      int start = xml.indexOf("<entry>", pos);
      if (start == -1) break;
      int end   = xml.indexOf("</entry>", start);
      if (end == -1) break;

      String entry = xml.substring(start, end);

      String title = extractXmlValue(entry, "title");
      String summaryHtml = extractXmlValue(entry, "summary");

      // Clean CDATA HTML if present
      summaryHtml.replace("<![CDATA[", "");
      summaryHtml.replace("]]>", "");
      summaryHtml.replace("<br/>", "\n");
      summaryHtml.replace("<br />", "\n");
      summaryHtml.replace("<b>", "");
      summaryHtml.replace("</b>", "");
      summaryHtml.trim();
      
      alertTitle = title;
      alertSummary = summaryHtml;
      break;
    }

    Serial.printf("Alert title: '%s'\n", alertTitle.c_str());
    Serial.printf("alertActive=%d alertJustAppeared=%d\n",alertActive, alertJustAppeared);
    Serial.println("Parsed Alert:");
    Serial.println(alertTitle);
    Serial.println(alertSummary);
  }
  http.end();
}

void getAuroraData() {

  Serial.println("Fetching Aurora Data...");

  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("WiFi not connected.");
    return;
  }

  WiFiClientSecure client;
  client.setInsecure();   // Required for HTTPS

  HTTPClient http;
  http.setFollowRedirects(HTTPC_STRICT_FOLLOW_REDIRECTS);
  http.begin(client, auroraURL);

  int httpCode = http.GET();
  Serial.print("HTTP Code: ");
  Serial.println(httpCode);

  if (httpCode == 200) {
    String payload = http.getString();
    payload.trim();   // remove newline

    Serial.print("Raw Payload: [");
    Serial.print(payload);
    Serial.println("]");

    auroraValue = payload.toInt();
    auroraValid = true;

    Serial.print("Parsed Aurora Value: ");
    Serial.println(auroraValue);
  }
  else {
    Serial.println("Failed to fetch aurora data.");
    auroraValid = false;
  }

  http.end();
}

void drawAuroraBar(int value) {

  uint16_t barColor;

  if (value >= 80)
    barColor = TFT_RED;
  else if (value > 65)
    barColor = TFT_YELLOW;
  else if (value > 50)
    barColor = TFT_GREENYELLOW;
  else
    barColor = TFT_WHITE;

  // Clear only bar region
  //tft.fillRect(BAR_X, BAR_Y, BAR_WIDTH, BAR_HEIGHT + 12, TFT_BLACK);

  // Outline
  tft.drawRect(BAR_X, BAR_Y, BAR_WIDTH, BAR_HEIGHT, TFT_DARKGREY);

  int fillWidth = map(value, 0, 100, 0, BAR_WIDTH);

  if (fillWidth > 0)
    tft.fillRect(BAR_X + 1, BAR_Y + 1,
                 fillWidth - 2, BAR_HEIGHT - 2,
                 barColor);

  // Tick marks
  for (int i = 0; i <= 4; i++) {
    int tickX = BAR_X + (i * BAR_WIDTH / 4);
    tft.drawLine(tickX, BAR_Y + BAR_HEIGHT,
                 tickX, BAR_Y + BAR_HEIGHT + 5,
                 TFT_LIGHTGREY);
  }

  tft.setTextSize(1);
  tft.setTextColor(TFT_LIGHTGREY, TFT_BLACK);

  tft.setCursor(BAR_X - 2, BAR_Y + BAR_HEIGHT + 6);
  tft.print("0");

  tft.setCursor(BAR_X + BAR_WIDTH/2 - 6, BAR_Y + BAR_HEIGHT + 6);
  tft.print("50");

  tft.setCursor(BAR_X + BAR_WIDTH - 18, BAR_Y + BAR_HEIGHT + 6);
  tft.print("100");
}

