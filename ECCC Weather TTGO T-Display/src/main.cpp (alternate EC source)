void getAuroraData() {

  Serial.println("Fetching Aurora Data...");

  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("WiFi not connected.");
    return;
  }

  WiFiClientSecure client;
  client.setInsecure();   // Required for HTTPS

  HTTPClient http;
  http.setFollowRedirects(HTTPC_STRICT_FOLLOW_REDIRECTS);
  http.begin(client, auroraURL);

  int httpCode = http.GET();
  Serial.print("HTTP Code: ");
  Serial.println(httpCode);

  if (httpCode == 200) {
    String payload = http.getString();
    payload.trim();   // remove newline

    Serial.print("Raw Payload: [");
    Serial.print(payload);
    Serial.println("]");

    auroraValue = payload.toInt();
    auroraValid = true;

    Serial.print("Parsed Aurora Value: ");
    Serial.println(auroraValue);
  }
  else {
    Serial.println("Failed to fetch aurora data.");
    auroraValid = false;
  }

  http.end();
}

void drawAuroraBar(int value) {
  uint16_t barColor;
  if (value >= 80)
    barColor = TFT_RED;
  else if (value > 65)
    barColor = TFT_YELLOW;
  else if (value > 50)
    barColor = TFT_GREENYELLOW;
  else
    barColor = TFT_WHITE;
  // Clear only bar region
  //tft.fillRect(BAR_X, BAR_Y, BAR_WIDTH, BAR_HEIGHT + 12, TFT_BLACK);
  // Outline
  tft.drawRect(BAR_X, BAR_Y, BAR_WIDTH, BAR_HEIGHT, TFT_DARKGREY);

  int fillWidth = map(value, 0, 100, 0, BAR_WIDTH);

  if (fillWidth > 0)
    tft.fillRect(BAR_X + 1, BAR_Y + 1,
                 fillWidth - 2, BAR_HEIGHT - 2,
                 barColor);

  // Tick marks
  for (int i = 0; i <= 4; i++) {
    int tickX = BAR_X + (i * BAR_WIDTH / 4);
    tft.drawLine(tickX, BAR_Y + BAR_HEIGHT,
                 tickX, BAR_Y + BAR_HEIGHT + 5,
                 TFT_LIGHTGREY);
  }

  tft.setTextSize(1);
  tft.setTextColor(TFT_LIGHTGREY, TFT_BLACK);

  tft.setCursor(BAR_X - 2, BAR_Y + BAR_HEIGHT + 6);
  tft.print("0");

  tft.setCursor(BAR_X + BAR_WIDTH/2 - 6, BAR_Y + BAR_HEIGHT + 6);
  tft.print("50");

  tft.setCursor(BAR_X + BAR_WIDTH - 18, BAR_Y + BAR_HEIGHT + 6);
  tft.print("100");
}

void drawAlertIndicator() {
  uint16_t color;
  if (alertActive) {
    color = alertColorFor(alertTitle);
  } else {
    color = TFT_DARKCYAN; // no alert
  }
  // Handle blinking
  if (alertActive) {
    unsigned long now = millis();

    if (now - lastBlinkTime > BLINK_INTERVAL) {
      blinkState = !blinkState;
      lastBlinkTime = now;
    }
  } else {
    blinkState = true; // always visible when no alert
  }
  // Draw or erase
  if (blinkState) {
    tft.fillCircle(ALERT_DOT_X, ALERT_DOT_Y, ALERT_DOT_R, color);
  } else {
    tft.fillCircle(ALERT_DOT_X, ALERT_DOT_Y, ALERT_DOT_R, TFT_BLACK);
  }
}

