void drawAuroraPage() {

  tft.setTextSize(2);
  tft.setCursor(0, 0);

  if (!auroraValid) {
    tft.setTextColor(TFT_WHITE);
    tft.print("No Aurora Data");
    return;
  }

  uint16_t textColor;

  if (auroraValue >= 80)
    textColor = TFT_RED;
  else if (auroraValue > 65)
    textColor = TFT_YELLOW;
  else if (auroraValue > 50)
    textColor = TFT_GREENYELLOW;
  else
    textColor = TFT_WHITE;

  tft.setTextColor(textColor, TFT_BLACK);
  tft.printf("Aurora borealis:\n\n ");
  tft.setTextSize(4);
  tft.printf("   %d%%", auroraValue);

  // Draw bar
  drawAuroraBar(auroraValue);
}

