// ===== Setup =====
void setup() {
  Serial.begin(115200);
  tft.init();
  tft.setRotation(1);
  showBootScreen();
  tft.fillScreen(TFT_BLACK);
 

  pinMode(BTN_BRIGHTNESS, INPUT_PULLUP);
  ledcSetup(BACKLIGHT_CHANNEL, BACKLIGHT_FREQ, BACKLIGHT_RES);
  ledcAttachPin(BACKLIGHT_PIN, BACKLIGHT_CHANNEL);
  ledcWrite(BACKLIGHT_CHANNEL, 20);  // Start at low brightness

  connectWiFi();
  fetchWeather();
  fetchAlerts();
  lastAuroraUpdate = millis() - AURORA_INTERVAL;


  pageTimer = millis();
  drawPageOne();
}
void handleBrightnessButton() {
  static bool lastState = HIGH;
  static unsigned long lastDebounce = 0;

  bool current = digitalRead(BTN_BRIGHTNESS);

  if (current != lastState) {
    lastDebounce = millis();
  }

  if ((millis() - lastDebounce) > 50) { 
    if (lastState == HIGH && current == LOW) {
      brightnessIndex++;
      if (brightnessIndex >= NUM_LEVELS) brightnessIndex = 0;

      ledcWrite(pwmChannel, brightnessLevels[brightnessIndex]);

      Serial.printf("Brightness: %d\n",
        brightnessLevels[brightnessIndex]);
    }
  }

  lastState = current;
}

// ===== Main Loop =====
void loop() {
  unsigned long now = millis();
  handleBrightnessButton();
  static bool lastAlertState = false;

if (alertActive != lastAlertState) {
  pageTimer = now;
  currentPage = PAGE_ONE;
  tft.fillScreen(TFT_BLACK);
  lastAlertState = alertActive;
}

  // Weather update
  if (now - lastWeatherUpdate > WEATHER_INTERVAL) {
    fetchWeather();
    tft.fillScreen(TFT_BLACK);
    lastWeatherUpdate = now;
  }

  // Alerts update
  if (now - lastAlertsUpdate > ALERTS_INTERVAL) {
    fetchAlerts();
    lastAlertsUpdate = now;
  }

  if (millis() - lastAuroraUpdate >= AURORA_INTERVAL) {
  lastAuroraUpdate = millis();
  getAuroraData();
}

 // Page switching
  if (now - pageTimer > PAGE_DURATION) {
    pageTimer = now;

    switch (currentPage) {
      case PAGE_ONE:
        currentPage = PAGE_TWO;
        break;

      case PAGE_TWO:
        currentPage = PAGE_THREE;
        break;

      case PAGE_THREE:
        currentPage = PAGE_FOUR;
        break;

      case PAGE_FOUR:
        currentPage = PAGE_FIVE;
        break;

      case PAGE_FIVE:
        currentPage = AURORA_PAGE;
        break;

      case AURORA_PAGE:
        currentPage = ALERT_PAGE;
        break;

      default:
        currentPage = PAGE_ONE;
        break;
    }

    tft.fillScreen(TFT_BLACK);
  }

  // Draw current page
  if (currentPage == PAGE_ONE) {
    drawPageOne();
  }
  else if (currentPage == PAGE_TWO) {
    drawPageTwo();
  }
  else if (currentPage == PAGE_THREE) {
    drawPageThree();
  }
  else if (currentPage == PAGE_FOUR) {
    drawPageFour();
  }
  else if (currentPage == PAGE_FIVE) {
    drawPageFive();
  }
  else if (currentPage == AURORA_PAGE) {
  drawAuroraPage();
}
  else {
    drawAlertPage();
  }
 ///////////////////////////////////////////////////////////

  delay(50); // light yield

  //Brightness button
  static bool lastBtn = HIGH;
  bool btn = digitalRead(BTN_BRIGHTNESS);

  if (lastBtn == HIGH && btn == LOW) {
    brightnessIndex = (brightnessIndex + 1) % NUM_LEVELS;
    ledcWrite(BACKLIGHT_CHANNEL, brightnessLevels[brightnessIndex]);

    Serial.printf("Brightness level: %d\n",
                  brightnessLevels[brightnessIndex]);

    delay(250); // debounce
  }
  lastBtn = btn;
}

