String formatObservedTime(String raw) {
  raw.replace("Observed at:", "");
  raw.trim();

  const char* days[] = {
    " Monday", " Tuesday", " Wednesday",
    " Thursday", " Friday", " Saturday", " Sunday"
  };

  for (int i = 0; i < 7; i++) {
    int idx = raw.indexOf(days[i]);
    if (idx > 0) {
      raw = raw.substring(0, idx);
      break;
    }
  }

  raw.replace("Calgary Int'l Airport", "Calgary");
  raw.replace(" AM", "AM");  // <-- remove space before AM
  raw.replace(" PM", "PM");  // <-- remove space before PM
  raw.trim();

  return raw;
}


void drawWordWrappedText(int x, int y, int maxWidth, const String &text) {
  int cursorX = x;
  int cursorY = y;
  int lineHeight = tft.fontHeight();
  int spaceWidth = tft.textWidth(" ");
  tft.setCursor(cursorX, cursorY);
  int i = 0;
  while (i < text.length()) {
    // Explicit newline
    if (text[i] == '\n') {
      cursorX = x;
      cursorY += lineHeight;
      tft.setCursor(cursorX, cursorY);
      i++;
      continue;
    }
    // Extract next word
    int start = i;
    while (i < text.length() && text[i] != ' ' && text[i] != '\n') i++;
    String word = text.substring(start, i);
    int wordWidth = tft.textWidth(word);
    // Wrap if needed
    if (cursorX != x && cursorX + wordWidth > x + maxWidth) {
      cursorX = x;
      cursorY += lineHeight;
      tft.setCursor(cursorX, cursorY);
    }
    // Draw word
    tft.print(word);
    cursorX += wordWidth;

    // Handle space AFTER word
    if (i < text.length() && text[i] == ' ') {
      // Only draw space if it fits on this line
      if (cursorX + spaceWidth <= x + maxWidth) {
        tft.print(" ");
        cursorX += spaceWidth;
      } else {
        cursorX = x;
        cursorY += lineHeight;
        tft.setCursor(cursorX, cursorY);
      }
      i++;  // consume space
    }
  }
}

void updateSecondsBar(int sec) {

  // First time or page entry → draw full correct state
  if (lastBarSec == -1) {
    for (int i = 0; i < totalSegments; i++) {
      int x = barStartX + i * (segWidth + segGap);

    if (i <= sec) {
      uint16_t color = (i % 10 == 0) ? TFT_ORANGE : TFT_GREEN;
      tft.fillRect(x, barY, segWidth, segHeight, color);
    } else {
        tft.fillRect(x, barY, segWidth, segHeight, TFT_DARKCYAN);
      }
    }

    lastBarSec = sec;
    return;
  }

  // No change → do nothing
  if (sec == lastBarSec) return;

  int x;

  // New minute → clear all
  if (sec == 0) {
    for (int i = 0; i < totalSegments; i++) {
      x = barStartX + i * (segWidth + segGap);
      tft.fillRect(x, barY, segWidth, segHeight, TFT_DARKCYAN);
    }
  } else {
    // Only draw the new segment
    x = barStartX + sec * (segWidth + segGap);
    uint16_t color = (sec % 10 == 0) ? TFT_ORANGE : TFT_GREEN;
    tft.fillRect(x, barY, segWidth, segHeight, color);
  }

  lastBarSec = sec;
}

