// ===== Fetch and Parse Weather =====
void fetchWeather() {
  HTTPClient http;
  http.begin(WEATHER_RSS_URL);

  int code = http.GET();
  Serial.printf("Weather RSS HTTP code: %d\n", code);

  if (code == 200) {
    String xml = http.getString();
    fetchForecast24h(xml);


    // Find correct <entry> with current conditions
    int pos = 0;
    while (true) {
      int start = xml.indexOf("<entry>", pos);
      if (start == -1) break;
      int end   = xml.indexOf("</entry>", start);
      if (end == -1) break;

      String entry = xml.substring(start, end);

      // Category for current conditions
      String entryTitle = extractXmlValue(entry, "title");

        // Select the "Current Conditions" entry
        if (!entryTitle.startsWith("Current Conditions")) {
          pos = end + 8;
          continue;
        }
      // Extract updated timestamp
      ccUpdated = extractXmlValue(entry, "updated");
      // Extract summary CDATA
      String summary = extractXmlValue(entry, "summary");
      
      summary.replace("<![CDATA[", "");
      summary.replace("]]>", "");
      summary.replace("<br/>", "\n");
      summary.replace("<br />", "\n");
      summary.replace("<b>", "");
      summary.replace("</b>", "");
      summary.replace("&deg;C", ""); // add C 
      summary.trim();

      // Parse labeled values
      ccObservedAt = formatObservedTime(
                 extractLabeledValue(summary, "Observed at:")
               );

      //ccObservedAt  = extractLabeledValue(summary, "Observed at:");
      ccCondition   = extractLabeledValue(summary, "Condition:");
      ccTemperature = extractLabeledValue(summary, "Temperature:");
        ccPressure = extractLabeledValue(summary, "Pressure / Tendency:");
        ccPressure.trim();
            if (ccPressure.isEmpty()) {
              ccPressure = extractLabeledValue(summary, "Pressure:");
              ccPressure.trim();
      }
      ccVisibility  = extractLabeledValue(summary, "Visibility:");
      ccHumidity    = extractLabeledValue(summary, "Humidity:");
      ccDewpoint    = extractLabeledValue(summary, "Dewpoint:");
      ccWindChill   = extractLabeledValue(summary, "Wind Chill:");
      ccWind        = extractLabeledValue(summary, "Wind:");
      ccGust        = extractLabeledValue(summary, "Gust:");
      ccAQHI        = extractLabeledValue(summary, "Air Quality Health Index:");
      ccAQHI.trim();
      if (ccAQHI == "10+") {
          aqhiValue = 11;          // represent 10+ internally as 11
            }
      else if (ccAQHI.length() == 0 || ccAQHI == "N/A") {
        aqhiValue = -1;          // unavailable
          }
        else {
      aqhiValue = ccAQHI.toInt();
          }
      ccHumidex     = extractLabeledValue(summary, "Humidex:");

      break;
    }

    Serial.println("Parsed Weather:");
    Serial.println(ccObservedAt);
    Serial.println(ccCondition);
    Serial.println(ccTemperature);
    Serial.println(ccHumidity);
    Serial.println(ccAQHI);
    Serial.println(ccHumidex);
Serial.print("AQHI = '");
Serial.print(ccAQHI);
Serial.println("'");
  }

  http.end();
}
void fetchForecast24h(const String &xml) {

  fc6hrTitle = "";
  fc6hrSummary = "";
  fc12hrTitle = "";
  fc12hrSummary = "";

  int pos = 0;
  int found = 0;

  while (true) {
    int start = xml.indexOf("<entry>", pos);
    if (start == -1) break;

    int end = xml.indexOf("</entry>", start);
    if (end == -1) break;

    String entry = xml.substring(start, end);
    pos = end + 8;

    // Only forecast entries
    if (entry.indexOf("Weather Forecasts") == -1) continue;

    String title   = extractXmlValue(entry, "title");
    String summary = extractXmlValue(entry, "summary");

    // Clean HTML / CDATA
    summary.replace("<![CDATA[", "");
    summary.replace("]]>", "");
    summary.replace("<br/>", "\n");
    summary.replace("<br />", "\n");
    summary.replace("<b>", "");
    summary.replace("</b>", "");
    summary.trim();

    if (found == 0) {
      fc6hrTitle = title;
      fc6hrSummary = summary;
    } else if (found == 1) {
      fc12hrTitle = title;
      fc12hrSummary = summary;
      break;  // we only need 24h
    }

    found++;
  }
}

